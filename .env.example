# --- LLM (Google AI Studio / Gemini) ---
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_MODEL=gemini-3.8-flash

# --- Campify backend (public read-only endpoints; server-to-server) ---
# No trailing slash
CAMPIFY_API_URL=https://campify-p9y9.onrender.com/api

# --- Campify frontend (used to build /campgrounds/:id links) ---
# No trailing slash
CLIENT_URL=https://your-campify-frontend.vercel.app

# --- CORS: comma-separated list of allowed browser origins (no trailing slashes) ---
ALLOWED_ORIGINS=http://localhost:5173,https://your-campify-frontend.vercel.app

# --- Server port (Render sets this automatically; 4000 is the local default) ---
PORT=4000
